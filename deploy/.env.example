# DEP-1: copy to /srv/pera/.env on the VPS (bootstrap-vps.sh writes it with generated values).
# Never commit the real file.

# Database password (letters and digits only, so it is safe inside the connection string).
POSTGRES_PASSWORD=change-me
# JWT signing key: at least 32 random characters.
JWT_KEY=change-me-to-a-long-random-string-of-64-characters
# First admin's password (admin@system.dms). Used only when the admin does not exist yet.
ADMIN_PASSWORD=Change-Me-1!

# The address people open, used for CORS. http://<VPS IP> now; https://your.domain later
# (together with the first line of /srv/edge/conf/pera.caddy).
PUBLIC_ORIGIN=http://203.0.113.10

# Image tags: "latest" follows main/master; set a commit SHA to pin or roll back.
API_TAG=latest
WEB_TAG=latest

# Memory limits. The VPS is shared with other sites; PERA measured ~260 MB in total.
API_MEM_LIMIT=768m
POSTGRES_MEM_LIMIT=512m

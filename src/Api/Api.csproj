<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>dms-modular-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <!--
      Needed only so the `dotnet ef migrations add` CLI (pointed at Api as the startup project) runs
      at all - the EF tool requires the startup project to reference this package, even though the
      actual DbContext is resolved through each module's own IDesignTimeDbContextFactory, never
      through Api itself. PrivateAssets=all keeps it out of Api's own published output.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedKernel\SharedKernel.csproj" />
    <ProjectReference Include="..\BuildingBlocks\BuildingBlocks.csproj" />
    <ProjectReference Include="..\BuildingBlocks.Web\BuildingBlocks.Web.csproj" />
    <!--
      The composition root references every module's Infrastructure project, per the reference matrix
      ("Api: everything"), even though it can never name any of their internal types directly (IModule
      implementations are internal - only *.Contracts is public). Program.cs discovers them by loading
      the assembly by name (Assembly.Load), not by referencing a type from it.
    -->
    <ProjectReference Include="..\Modules\Approvals\Approvals.Infrastructure\Approvals.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Projects\Projects.Infrastructure\Projects.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Projects\Projects.Application\Projects.Application.csproj" />
    <!-- Same reasoning as the Identity.Application/Hr.Application references below: ApprovalsModule.Register's
         Assembly.Load("Approvals.Application") needs this DLL present in Api's output directory. -->
    <ProjectReference Include="..\Modules\Approvals\Approvals.Application\Approvals.Application.csproj" />
    <ProjectReference Include="..\Modules\Identity\Identity.Infrastructure\Identity.Infrastructure.csproj" />
    <!--
      Identity.Application is never referenced by Identity.Infrastructure (that would be circular -
      Application already depends on its own Infrastructure). Infrastructure's IdentityModule.Register
      finds its handlers via Assembly.Load("Identity.Application") at runtime, which only succeeds if
      that DLL is present in Api's output directory - hence this reference exists purely to get it
      copied there, never to name a type from it.
    -->
    <ProjectReference Include="..\Modules\Identity\Identity.Application\Identity.Application.csproj" />
    <ProjectReference Include="..\Modules\Hr\Hr.Infrastructure\Hr.Infrastructure.csproj" />
    <!-- Same reasoning as the Identity.Application reference above: HrModule.Register's
         Assembly.Load("Hr.Application") needs this DLL present in Api's output directory. -->
    <ProjectReference Include="..\Modules\Hr\Hr.Application\Hr.Application.csproj" />
    <!-- Added at G7-03, ahead of the rest of Documents' wiring, purely so the `dotnet ef migrations add`
         CLI (startup project Api) can find DocumentsDbContext's assembly in Api's build output. Program.cs's
         own Assembly.Load("Documents.Infrastructure") + moduleAssemblies registration land at G7-08, now
         that the module has endpoints to actually serve. -->
    <ProjectReference Include="..\Modules\Documents\Documents.Infrastructure\Documents.Infrastructure.csproj" />
    <!-- Same reasoning as the Identity.Application/Hr.Application references above: DocumentsModule.Register's
         Assembly.Load("Documents.Application") needs this DLL present in Api's output directory. -->
    <ProjectReference Include="..\Modules\Documents\Documents.Application\Documents.Application.csproj" />
    <!-- Added at G9-07, same reasoning as Documents' G7-03 precedent: purely so the `dotnet ef migrations
         add` CLI (startup project Api) can find CrmDbContext's assembly in Api's build output.
         Program.cs's own Assembly.Load("Crm.Infrastructure") + moduleAssemblies registration land at
         G9-14, now that the module has endpoints to actually serve. -->
    <ProjectReference Include="..\Modules\Crm\Crm.Infrastructure\Crm.Infrastructure.csproj" />
    <!-- Same reasoning as the Identity.Application/Hr.Application/Documents.Application references
         above: CrmModule.Register's Assembly.Load("Crm.Application") needs this DLL present in Api's
         output directory. -->
    <ProjectReference Include="..\Modules\Crm\Crm.Application\Crm.Application.csproj" />
    <!-- Sites (S1-04). Both references for the established reasons: Infrastructure so the EF CLI can
         find SitesDbContext and so Program.cs's Assembly.Load resolves, Application so
         SitesModule.Register's own Assembly.Load("Sites.Application") finds the DLL in Api's output.
         Neither is ever used to NAME a type from those assemblies. -->
    <ProjectReference Include="..\Modules\Sites\Sites.Infrastructure\Sites.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Sites\Sites.Application\Sites.Application.csproj" />
    <!-- Notifications (N1-01). Both references for the established reasons: Infrastructure so the EF
         CLI can find NotificationsDbContext (N1-03) and so Program.cs's Assembly.Load resolves (N1-07),
         Application so NotificationsModule.Register's own Assembly.Load("Notifications.Application")
         finds the DLL in Api's output. Neither is ever used to NAME a type from those assemblies.
         Added here at N1-01, ahead of the rest of the wiring, because Integration.Tests references only
         Api.csproj - ApiFixture cannot Assembly.Load a module whose DLL never reaches Api's output. -->
    <ProjectReference Include="..\Modules\Notifications\Notifications.Infrastructure\Notifications.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Notifications\Notifications.Application\Notifications.Application.csproj" />
    <!-- Finance (F1-04). Added here ahead of the rest of the wiring for exactly the reason recorded on
         the Notifications pair above: Integration.Tests references only Api.csproj, so ApiFixture
         cannot Assembly.Load a module whose DLL never reaches Api output - and ApiFixture must migrate
         the finance schema from F1-04 onward, since "finance" is now in ModuleDependencyOrder. Also
         what lets the `dotnet ef migrations add` CLI (startup project Api) find FinanceDbContext.
         Program.cs's own Assembly.Load("Finance.Infrastructure") + moduleAssemblies registration land
         at F1-09, once the module has endpoints to serve; until then FinanceModule is referenced but
         never registered in the host, and Boot_RegistersExactlyEightModules stays correct. -->
    <ProjectReference Include="..\Modules\Finance\Finance.Infrastructure\Finance.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Finance\Finance.Application\Finance.Application.csproj" />
  </ItemGroup>

</Project>

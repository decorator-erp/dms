{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Information" }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=dms_modular;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Issuer": "DMS.Modular.Api",
    "Audience": "DMS.Modular.Client",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 14
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Outbox": {
    "FallbackPollSeconds": 60
  },
  "OfficeHours": {
    "WorkingDays": [ 0, 1, 2, 3, 4 ],
    "DayStartLocal": "09:00",
    "DayEndLocal": "17:00",
    "SlotMinutes": 60,
    "TimezoneId": "Africa/Cairo"
  },
  "FileStorage": {
    "RootPath": "uploads",
    "MaxUploadBytes": 52428800
  }
}

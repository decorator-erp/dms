{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Information" }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=dms_modular;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Issuer": "DMS.Modular.Api",
    "Audience": "DMS.Modular.Client",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 14
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}

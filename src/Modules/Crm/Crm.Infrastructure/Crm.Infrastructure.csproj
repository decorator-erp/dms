<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\SharedKernel\SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks.Web\BuildingBlocks.Web.csproj" />
    <ProjectReference Include="..\Crm.Contracts\Crm.Contracts.csproj" />
    <ProjectReference Include="..\Crm.Domain\Crm.Domain.csproj" />
    <!-- Structural item 2's outbound direction: Crm.Infrastructure implements
         Projects.Contracts.IGateConditionTypeHandler x3 (CrmBriefApprovedHandler/CrmItemsResolvedHandler/
         CrmPeriodClosedHandler live in Crm.Application, but CrmModule's Scrutor scan for them, here in
         Infrastructure, needs to name the interface type - same technique DocumentsModule already uses).
         G9-13. -->
    <ProjectReference Include="..\..\Projects\Projects.Contracts\Projects.Contracts.csproj" />
    <!-- Cross-module read: validates CrmArtifactDocument.DocumentId against
         Documents.Contracts.IDocumentQueries.GetAsync at artifact-creation time - the replacement for
         the FK structural item 1 drops. G9-12. -->
    <ProjectReference Include="..\..\Documents\Documents.Contracts\Documents.Contracts.csproj" />
    <!-- Cross-module read: ApprovalDecidedIntegrationEventHandler (G9-13) subscribes to
         Approvals.Contracts.ApprovalDecidedIntegrationEvent, filtered to DesignBrief/RequirementItem/
         BriefSpace. -->
    <ProjectReference Include="..\..\Approvals\Approvals.Contracts\Approvals.Contracts.csproj" />
    <!-- Cross-module read: CrmAccessGuard's employee branch resolves via
         Hr.Contracts.IHrDirectory.ResolveEmployeeIdAsync (G9-08) - the client branch is CRM-owned data
         and stays local, mirroring ProjectAccessGuard's own employee/client-analog split. -->
    <ProjectReference Include="..\..\Hr\Hr.Contracts\Hr.Contracts.csproj" />
    <!-- N1-06: MeetingScheduledNotificationHandler calls INotificationService. -->
    <ProjectReference Include="..\..\Notifications\Notifications.Contracts\Notifications.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Crm.Application needs this despite never being referenced BY Crm.Infrastructure - same
         reasoning as Documents.Infrastructure.csproj's identical grant: it uses CrmDbContext directly. -->
    <InternalsVisibleTo Include="Crm.Application" />
    <InternalsVisibleTo Include="Crm.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Crm.Application.Tests" />
  </ItemGroup>

</Project>

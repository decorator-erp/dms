<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\SharedKernel\SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks.Web\BuildingBlocks.Web.csproj" />
    <ProjectReference Include="..\Documents.Contracts\Documents.Contracts.csproj" />
    <ProjectReference Include="..\Documents.Domain\Documents.Domain.csproj" />
    <!-- G7-07, structural item 2's first direction: Documents implements
         Projects.Contracts.IGateConditionTypeHandler (AttachmentHandler/DocumentApprovedHandler live in
         Documents.Application, but DocumentsModule's Scrutor scan for them, here in Infrastructure,
         needs to name the interface type). Legal and not a cycle - Projects.Contracts references only
         SharedKernel/BuildingBlocks, never its own module's implementation. See
         Projects.Infrastructure.csproj's matching Documents.Contracts reference for the other direction. -->
    <ProjectReference Include="..\..\Projects\Projects.Contracts\Projects.Contracts.csproj" />
    <!-- Cross-module read: ApprovalDecidedIntegrationEventHandler (G7-07) subscribes to
         Approvals.Contracts.ApprovalDecidedIntegrationEvent, filtered to ApprovalSubjectType.ProjectDocument. -->
    <ProjectReference Include="..\..\Approvals\Approvals.Contracts\Approvals.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Documents.Application needs this despite never being referenced BY Documents.Infrastructure -
         same reasoning as Hr.Infrastructure.csproj's identical grant: it uses DocumentsDbContext directly. -->
    <InternalsVisibleTo Include="Documents.Application" />
    <InternalsVisibleTo Include="Documents.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Documents.Application.Tests" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\SharedKernel\SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks.Web\BuildingBlocks.Web.csproj" />
    <ProjectReference Include="..\Projects.Contracts\Projects.Contracts.csproj" />
    <!-- F1-08: the second half of the bidirectional Finance/Projects pair. Finance.Infrastructure takes
         Projects.Contracts (BudgetHandler); this takes Finance.Contracts to consume the five events that
         drive Budget gates. Two modules referencing each other's CONTRACTS is the intended shape - what
         rule 3 forbids is referencing the other's Domain/Application/Infrastructure, and neither does.
         This reference is also what makes arch rule 10 non-vacuous for Finance for the first time. -->
    <ProjectReference Include="..\..\Finance\Finance.Contracts\Finance.Contracts.csproj" />
    <ProjectReference Include="..\Projects.Domain\Projects.Domain.csproj" />
    <!-- Cross-module reads: IProjectAccessGuard (G5-05) calls Hr.Contracts.IHrDirectory. Cross-module
         *.Contracts references are always allowed. -->
    <ProjectReference Include="..\..\Hr\Hr.Contracts\Hr.Contracts.csproj" />
    <ProjectReference Include="..\..\Approvals\Approvals.Contracts\Approvals.Contracts.csproj" />
    <!-- G7-07, structural item 2's second direction: subscribes to
         Documents.Contracts.DocumentUploadedIntegrationEvent/DocumentApprovedIntegrationEvent to
         satisfy Attachment/DocumentApproved gates. Legal and not a cycle - see
         Documents.Infrastructure.csproj's matching Projects.Contracts reference for the other
         direction and PROGRESS.md's G7-07 entry for the full reasoning. -->
    <ProjectReference Include="..\..\Documents\Documents.Contracts\Documents.Contracts.csproj" />
    <!-- G9-13: subscribes to Crm.Contracts.CrmBriefApprovedIntegrationEvent/CrmPeriodClosedIntegrationEvent/
         CrmItemsResolvedIntegrationEvent to satisfy the three CRM gate types. Legal and not a cycle -
         see Crm.Infrastructure.csproj's matching Projects.Contracts reference for the other direction. -->
    <ProjectReference Include="..\..\Crm\Crm.Contracts\Crm.Contracts.csproj" />
    <!-- N1-06: the two project-stage notification handlers call INotificationService. -->
    <ProjectReference Include="..\..\Notifications\Notifications.Contracts\Notifications.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Projects.Application" />
    <InternalsVisibleTo Include="Projects.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Projects.Application.Tests" />
  </ItemGroup>

</Project>

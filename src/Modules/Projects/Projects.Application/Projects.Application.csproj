<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\SharedKernel\SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.csproj" />
    <ProjectReference Include="..\Projects.Contracts\Projects.Contracts.csproj" />
    <!-- N1-05: the three deadline jobs call INotificationService. The one allowed outbound direction;
         Notifications.Contracts depends on no module, which is what keeps this from closing a cycle
         (asserted by NotificationsContractsIsolationTests). -->
    <ProjectReference Include="..\..\Notifications\Notifications.Contracts\Notifications.Contracts.csproj" />
    <ProjectReference Include="..\Projects.Domain\Projects.Domain.csproj" />
    <!-- Own Infrastructure, same reasoning as every other module: handlers use ProjectsDbContext
         directly - "no repository pattern" - so Application needs the concrete type. -->
    <ProjectReference Include="..\Projects.Infrastructure\Projects.Infrastructure.csproj" />
    <!-- Cross-module reads: task assignment validates the employee via Hr.Contracts.IHrDirectory (G5-07);
         the Approval-type gate handler calls Approvals.Contracts.IApprovalRequester (G5-08). Cross-module
         *.Contracts references are always allowed. -->
    <ProjectReference Include="..\..\Hr\Hr.Contracts\Hr.Contracts.csproj" />
    <ProjectReference Include="..\..\Approvals\Approvals.Contracts\Approvals.Contracts.csproj" />
    <!-- G9-13: CreateProjectCommandHandler validates ClientId via Crm.Contracts.IClientDirectory,
         closing the Phase 2 deferral this phase exists to close. Legal and not a cycle - see
         Crm.Infrastructure.csproj's matching Projects.Contracts reference for the other direction. -->
    <ProjectReference Include="..\..\Crm\Crm.Contracts\Crm.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Projects.Application.Tests" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\SharedKernel\SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks.Web\BuildingBlocks.Web.csproj" />
    <ProjectReference Include="..\Finance.Contracts\Finance.Contracts.csproj" />
    <ProjectReference Include="..\Finance.Domain\Finance.Domain.csproj" />
    <!-- F1-08. Needed here only for the Scrutor scan that registers BudgetHandler: the scan names the
         PUBLIC interface type IGateConditionTypeHandler, which lives in Projects.Contracts. The handler
         itself is `internal` in Finance.Application and is never named from this assembly.
         Finance.Application carries the other three cross-module references (Crm/Hr/Notifications) for
         InvoiceDueJob, because that is where the job lives. -->
    <ProjectReference Include="..\..\Projects\Projects.Contracts\Projects.Contracts.csproj" />
    <!-- F1-09: FinanceEndpointActors resolves the calling user's HR employee id at the boundary, for
         the six commands that stamp a person on the row they create. Those four columns carry real
         foreign keys to hr.employees (F1-05), so this is a correctness dependency, not a convenience. -->
    <ProjectReference Include="..\..\Hr\Hr.Contracts\Hr.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Finance.Application uses FinanceDbContext directly ("no repository pattern"), so it needs the
         internal concrete type - the same grant every other module makes to its own Application. -->
    <InternalsVisibleTo Include="Finance.Application" />
    <InternalsVisibleTo Include="Finance.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Finance.Application.Tests" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Pinned directly: Npgsql 10.0.3 floats Relational to [10.0.4, 11.0.0), which NuGet otherwise
         resolves to the floor (10.0.4) instead of the central 10.0.10, conflicting with EFCore.Design. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Scrutor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedKernel\SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- N1-02: AuditSaveChangesInterceptor and NullAuditContextAccessor are internal - the interceptor
         because its only legitimate consumer is AddModuleDbContext, the accessor because it is a
         fallback nobody should register by hand. AuditInterceptorTests names both: it asserts the
         interceptor is a singleton across scopes (an EF internal-service-provider concern that has no
         observable behaviour to test through), and that a background scope resolves the null accessor.
         Making them public to test them would widen the surface the tests exist to constrain. -->
    <InternalsVisibleTo Include="BuildingBlocks.IntegrationTests" />
  </ItemGroup>

</Project>
